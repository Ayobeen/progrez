# Export these variables in your shell; no secrets are committed.
DEBUG=true
DEMO_MODE=true
SECRET_KEY=replace-with-a-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
# Optional PostgreSQL (SQLite is the development default)
# POSTGRES_DB=progrez
# POSTGRES_USER=progrez
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# Optional structured AI gateway; see README for the request/response contract.
# AI_SERVICE_URL=https://your-gateway.example/generate
# AI_SERVICE_KEY=
# Circle works with in-app notifications by default. Email delivery is opt-in.
CIRCLE_EMAIL_ENABLED=false
CIRCLE_SITE_ORIGIN=http://127.0.0.1:8000
# EMAIL_HOST=smtp.your-provider.example
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Progrez <hello@your-domain.example>
